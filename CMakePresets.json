{
    "version": 5,
    "configurePresets": [
        {
            "name": "vcpkg",
            "binaryDir": "${sourceDir}/build",
            "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "dev",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "DEFAULT_SHOW_DEBUG_INFO": "ON",
                "IMGUI_DEBUG_WINDOW_BEGIN_ONCE": "ON",
                "IMGUI_ALWAYS_ASSERT": "ON",
                "ENABLE_TEST_SANITIZERS": "ON"
            }
        },
        {
            "name": "windows-static",
            "inherits": ["vcpkg"],
            "cacheVariables": {
                "CMAKE_GENERATOR_PLATFORM": "x64",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "BUILD_SHARED_LIBS": "OFF",
                "ZLIB_USE_STATIC_LIBS": "ON",
                "BUILD_TESTS": "ON"
            },
            "condition": {
              "type": "equals",
              "lhs": "${hostSystemName}",
              "rhs": "Windows"
            }
        },
        {
            "name": "windows-static-ninja",
            "inherits": ["windows-static"],
            "generator": "Ninja"
        },
        {
            "name": "windows-static-ninja-multi",
            "inherits": ["windows-static"],
            "generator": "Ninja Multi-Config"
        },
        {
            "name": "windows-static-ninja-dev",
            "inherits": ["windows-static-ninja", "dev"]
        },
        {
            "name": "windows-static-ninja-multi-dev",
            "inherits": ["windows-static-ninja-multi", "dev"]
        },
        {
            "name": "linux",
            "inherits": ["vcpkg"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "hidden": true
        },
        {
            "name": "linux-make-dev",
            "inherits": ["linux", "dev"],
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "linux-ninja-multi-dev",
            "inherits": ["linux", "dev"],
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_DEFAULT_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_FLAGS_INIT": "-fdiagnostics-color=always",
                "CMAKE_CXX_FLAGS_INIT": "-fdiagnostics-color=always"
            }
        }
    ]
}
