{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build",
            "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "ZLIB_USE_STATIC_LIBS": "ON",
                "FETCH_GTEST": "ON",
                "BUILD_TESTS": "ON"
            }
        }
    ]
}
